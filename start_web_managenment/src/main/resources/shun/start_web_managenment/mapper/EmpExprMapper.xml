<?xml version="1.0" encoding="UTF-8" ?>
        <!DOCTYPE mapper
                PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
                "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="shun.start_web_managenment.mapper.EmpExprMapper">
        <!-- 批量插入员工表达式 -->
        <insert id="insertBatch">
                insert into emp_expr(emp_id, `begin`, `end`, company, job) values
                <foreach collection="exprList" item="expr" separator=",">
                        (#{expr.empId},#{expr.begin},#{expr.end},#{expr.company},#{expr.job})
                </foreach>
        </insert>
        <!-- 根据员工ID查询工作经历 -->
        <select id="listByEmpId" resultType="shun.start_web_managenment.pojo.EmpExpr">
                select * from emp_expr where emp_id = #{empId} order by `begin`
        </select>

        <!-- 根据员工ID删除工作经历 -->
        <delete id="deleteByEmpId">
                delete from emp_expr where emp_id = #{empId}
        </delete>
</mapper>